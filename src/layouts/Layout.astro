---
import '../styles/global.css';
import LanguageText from '../components/LanguageText.astro';
import ui from '../data/ui.json';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Dr. Mayna Talukdar | Professor of Sanskrit',
	description = 'Academic portfolio of Dr. Mayna Talukdar, Professor of Sanskrit at the University of Dhaka.',
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const navItems = [
	{ id: 'about', href: `${base}#about`, label: ui.nav.about },
	{ id: 'research', href: `${base}#research`, label: ui.nav.research },
	{ id: 'publications', href: `${base}#publications`, label: ui.nav.publications },
	{ id: 'teaching', href: `${base}#teaching`, label: ui.nav.teaching },
	{ id: 'service', href: `${base}#service`, label: ui.nav.service },
	{ id: 'contact', href: `${base}#contact`, label: ui.nav.contact },
];
---

<!doctype html>
		<html lang="en" data-language="en" data-theme="light">
		<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1c2857" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="profile" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Dr. Mayna Talukdar" />
		<script is:inline>
			try {
				const storedTheme = window.localStorage.getItem('mayna-theme');
				const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = storedTheme === 'dark' || storedTheme === 'light' ? storedTheme : systemTheme;
			} catch { /* Use the light fallback when storage is unavailable. */ }
		</script>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<div class="shell header-inner">
				<a class="brand" href={`${base}#about`} aria-label="Dr. Mayna Talukdar home">
					<span class="brand-mark" aria-hidden="true">ম</span>
					<span class="brand-copy"><strong>Mayna Talukdar</strong><small>University of Dhaka</small></span>
				</a>
				<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
					<span class="sr-only"><LanguageText {...ui.actions.toggleMenu} /></span>
					<span aria-hidden="true">☰</span>
				</button>
				<nav id="site-navigation" class="site-nav" aria-label="Primary navigation">
					{navItems.map((item) => <a href={item.href} data-nav-target={item.id} aria-current={item.id === 'about' ? 'location' : undefined}><LanguageText {...item.label} /></a>)}
				</nav>
				<div class="header-actions">
					<a class="du-link" href="https://du.ac.bd/faculty/faculty_details/SPL/1204" target="_blank" rel="noreferrer" aria-label="University of Dhaka faculty profile" title="University of Dhaka faculty profile">
						<span class="du-logo-frame"><img class="du-logo du-logo-white" src={`${base}images/university-of-dhaka-logo.png`} alt="University of Dhaka logo" /><img class="du-logo du-logo-shield" src={`${base}images/university-of-dhaka-logo.png`} alt="" aria-hidden="true" /></span>
					</a>
					<button class="theme-toggle" type="button" data-theme-toggle title="Change theme">
						<span data-theme-icon aria-hidden="true">☾</span><span class="sr-only"><LanguageText {...ui.actions.switchTheme} /></span>
					</button>
					<button class="language-toggle" type="button" data-language-toggle aria-label="Switch to Bengali" aria-pressed="false"><span class="lang-en">বাংলা</span><span class="lang-bn">English</span></button>
				</div>
			</div>
		</header>
		<main id="main-content"><slot /></main>
		<footer class="site-footer">
			<div class="shell footer-inner">
				<div><p class="footer-kicker">Sanskrit · Literature · Culture</p><p>Academic portfolio of Dr. Mayna Talukdar.</p></div>
				<a href={`${base}#about`}>Back to top ↑</a>
			</div>
		</footer>
		<script>
			const root = document.documentElement;
			const menuButton = document.querySelector('.menu-toggle');
			const navigation = document.querySelector('#site-navigation');
			const languageButton = document.querySelector('[data-language-toggle]');
			const themeButton = document.querySelector('[data-theme-toggle]');
			const themeIcon = document.querySelector('[data-theme-icon]');
			const navLinks = [...document.querySelectorAll('[data-nav-target]')];
			const navSections = navLinks
				.map((link) => document.getElementById(link.getAttribute('data-nav-target') ?? ''))
				.filter((section): section is HTMLElement => Boolean(section));
			const savedLanguage = window.localStorage.getItem('mayna-language');
			const updateLanguageButton = () => {
				const bengali = root.dataset.language === 'bn';
				const label = bengali ? 'Switch to English' : 'বাংলায় পরিবর্তন করুন';
				languageButton?.setAttribute('aria-label', label);
				languageButton?.setAttribute('title', label);
				languageButton?.setAttribute('aria-pressed', String(bengali));
			};
			// @ts-ignore Astro treats this inline browser script as JavaScript.
			const updateThemeButton = () => {
				const dark = root.dataset.theme === 'dark';
				const englishLabel = dark ? 'Switch to light theme' : 'Switch to dark theme';
				const bengaliLabel = dark ? 'লাইট থিমে পরিবর্তন করুন' : 'ডার্ক থিমে পরিবর্তন করুন';
				const label = root.dataset.language === 'bn' ? bengaliLabel : englishLabel;
				themeButton?.setAttribute('aria-label', label);
				themeButton?.setAttribute('title', label);
				if (themeIcon) themeIcon.textContent = dark ? '☀︎' : '☾';
			};
			const setTheme = (theme: 'dark' | 'light') => {
				root.dataset.theme = theme === 'dark' ? 'dark' : 'light';
				window.localStorage.setItem('mayna-theme', root.dataset.theme);
				updateThemeButton();
			};
			const setLanguage = (language: 'bn' | 'en') => {
				root.dataset.language = language;
				root.lang = language === 'bn' ? 'bn' : 'en';
				window.localStorage.setItem('mayna-language', language);
				updateLanguageButton();
				updateThemeButton();
			};
			const setActiveNav = (id: string) => {
				navLinks.forEach((link) => {
					if (link.getAttribute('data-nav-target') === id) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
				});
			};
			let lockedNavTarget: string | null = null;
			let navUnlockTimer: number | undefined;
			const releaseNavLock = () => {
				if (!lockedNavTarget) return;
				const target = lockedNavTarget;
				lockedNavTarget = null;
				if (navUnlockTimer !== undefined) window.clearTimeout(navUnlockTimer);
				setActiveNav(target);
			};
			const lockNavTarget = (target: string) => {
				lockedNavTarget = target;
				if (navUnlockTimer !== undefined) window.clearTimeout(navUnlockTimer);
				navUnlockTimer = window.setTimeout(releaseNavLock, 1400);
			};
			window.addEventListener('scrollend', releaseNavLock);
			const initialSection = window.location.hash.slice(1);
			setActiveNav(navSections.some((section) => section.id === initialSection) ? initialSection : 'about');
			const updateActiveNavFromScroll = () => {
				if (lockedNavTarget || navSections.length === 0) return;
				const atPageBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
				if (atPageBottom) {
					setActiveNav(navSections[navSections.length - 1].id);
					return;
				}
				const activationLine = window.innerHeight * 0.35;
				const currentSection = navSections.reduce((active, section) => section.getBoundingClientRect().top <= activationLine ? section : active, navSections[0]);
				setActiveNav(currentSection.id);
			};
			let scrollFrame: number | undefined;
			const scheduleActiveNavUpdate = () => {
				if (scrollFrame !== undefined) return;
				scrollFrame = window.requestAnimationFrame(() => {
					scrollFrame = undefined;
					updateActiveNavFromScroll();
				});
			};
			window.addEventListener('scroll', scheduleActiveNavUpdate, { passive: true });
			window.addEventListener('resize', scheduleActiveNavUpdate);
			if (savedLanguage === 'bn') setLanguage('bn');
			else updateLanguageButton();
			updateThemeButton();
			menuButton?.addEventListener('click', () => {
				const expanded = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!expanded));
				navigation?.classList.toggle('is-open', !expanded);
			});
			navigation?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
				const target = link.getAttribute('data-nav-target');
				if (target) {
					setActiveNav(target);
					lockNavTarget(target);
				}
				menuButton?.setAttribute('aria-expanded', 'false');
				navigation?.classList.remove('is-open');
			}));
			window.addEventListener('hashchange', () => {
				const target = window.location.hash.slice(1);
				if (target) setActiveNav(target);
			});
			themeButton?.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
			languageButton?.addEventListener('click', () => setLanguage(root.dataset.language === 'bn' ? 'en' : 'bn'));
		</script>
	</body>
</html>
