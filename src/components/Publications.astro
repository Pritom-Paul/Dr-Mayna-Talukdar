---
import LanguageText from './LanguageText.astro';
import SectionHeading from './SectionHeading.astro';
import profile from '../data/profile.json';

const publicationSource = 'https://du.ac.bd/publication/SPL';
---

<section id="publications" class="section">
	<div class="shell">
		<SectionHeading eyebrow={{ en: 'Selected scholarship', bn: 'নির্বাচিত গবেষণা' }} title={{ en: 'A record of research and publication.', bn: 'গবেষণা ও প্রকাশনার ধারাবাহিকতা।' }} description={{ en: 'Research books, educational works, and articles are presented with public links where available.', bn: 'গবেষণাগ্রন্থ, শিক্ষামূলক কাজ ও প্রবন্ধের তালিকা দেওয়া হয়েছে; যেখানে সম্ভব সেখানে প্রকাশ্য লিংক যুক্ত করা হয়েছে।' }} />
		<div class="hero-actions" style="margin-top: -16px; margin-bottom: 25px"><a class="button-secondary" href={publicationSource} target="_blank" rel="noreferrer"><LanguageText en="University publication record ↗" bn="বিশ্ববিদ্যালয়ের প্রকাশনা রেকর্ড ↗" /></a></div>
		<div class="pub-section">
			<h3><LanguageText {...{ en: 'Research Books', bn: 'গবেষণাগ্রন্থ' }} /> <span class="count">09 listed</span></h3>
			<div class="publication-list">{profile.publications.books.map((book) => <article class="publication-card"><div class="pub-year">{book.year}</div><div><h3>{book.title}</h3><p>{book.publisher}{book.note && ` · ${book.note}`}</p></div>{book.url && <a href={book.url} target="_blank" rel="noreferrer"><LanguageText en="View source ↗" bn="উৎস দেখুন ↗" /></a>}</article>)}</div>
		</div>
		<div class="pub-section">
			<h3><LanguageText en="Educational & Other Books" bn="শিক্ষামূলক ও অন্যান্য গ্রন্থ" /> <span class="count">04 listed</span></h3>
			<div class="publication-list">{profile.publications.otherBooks.map((book) => <article class="publication-card"><div class="pub-year">{book.year}</div><div><h3>{book.title}</h3><p>{book.publisher}{book.note && ` · ${book.note}`}</p></div></article>)}</div>
		</div>
		<div class="pub-section">
			<h3><LanguageText en="Research Articles" bn="গবেষণা প্রবন্ধ" /> <span class="count">20 itemized</span></h3>
			<div class="publication-list">{profile.publications.articles.map((article) => <article class="publication-card"><div class="pub-year">{String(article.year).slice(0, 4)}</div><div><h3>{article.title}</h3><p>{article.journal} · {article.volumeIssuePages}{article.doi && ` · DOI: ${article.doi}`}</p></div>{article.url && <a href={article.url} target="_blank" rel="noreferrer"><LanguageText {...(article.linkType === 'Official article page' ? { en: 'Read article ↗', bn: 'প্রবন্ধ পড়ুন ↗' } : { en: 'View source ↗', bn: 'উৎস দেখুন ↗' })} /></a>}</article>)}</div>
		</div>
	</div>
</section>
