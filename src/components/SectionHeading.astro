---
import LanguageText from './LanguageText.astro';

interface Props {
	eyebrow: { en: string; bn: string };
	title: { en: string; bn: string };
	description?: { en: string; bn: string };
}

const { eyebrow, title, description } = Astro.props;
---

<div class="section-heading">
	<p class="eyebrow"><LanguageText {...eyebrow} /></p>
	<h2><LanguageText {...title} /></h2>
	{description && <p class="section-description"><LanguageText {...description} /></p>}
</div>
